# Copy to .env next to docker-compose.yml if the defaults do not fit.
INGEST_PORT=8800
DATA_DIR_HOST=/srv/arkan-monitoring/data

# Firmware update from the live page (docs/OTA.md).
# Caddy login names (hub-users.caddy) allowed to send firmware to a logger, comma separated.
# Empty = the panel is off. "*" = everyone who can log in.
ADMIN_USERS=
# GitHub repository whose releases (tag fw-vX.Y.Z, made by CI) hold the logger-*.bin images.
FW_GITHUB_REPO=julien355/esp32-datalogging
# Only for a private repository: fine-grained token, this repository only, "Contents: read-only".
# Keep it in server/.env on the VPS (chmod 600), never in git.
FW_GITHUB_TOKEN=

# Weather forecast and log (docs/WEATHER.md): on by default for the sites that have lat/lon in site.json.
# WEATHER=off
# WEATHER_EVERY_MIN=60

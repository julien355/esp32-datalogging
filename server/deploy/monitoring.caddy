# /opt/edge/sites/monitoring.caddy on hermes-vps (native Caddy, imported by the main Caddyfile).
# Logins: the Arkan logins of every dashboard (/opt/edge/secrets/hub-users.caddy) and the logins for this
# platform only (/opt/edge/secrets/monitoring-users.caddy, technicians: docs/LIVE.md "Logins"). Both files
# must exist (the second may be empty). USER_SITES in server/.env limits a login to some sites.
# The loggers' endpoints are open (no basicauth): the device token is checked by the service.
# After any change: caddy validate, then the owner approves the reload.

arkan-monitoring.duckdns.org {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Loggers: token checked by the service, body size capped here too.
	@device {
		path /api/v1/ingest /api/v1/ota /api/v1/firmware/* /api/v1/config /api/v1/config/report /api/v1/registers
	}
	@livepost {
		method POST
		path /api/v1/live
	}
	handle @device {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8800
	}
	handle @livepost {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8800
	}

	# People: Arkan login, or a login for this platform only.
	handle {
		basicauth {
			import /opt/edge/secrets/hub-users.caddy
			import /opt/edge/secrets/monitoring-users.caddy
		}
		# Until Open Energy Dashboard is deployed, the start page is the live overview.
		redir / /live/ 302
		reverse_proxy 127.0.0.1:8800 {
			header_up X-Auth-User {http.auth.user.id}
		}
	}

	log {
		output file /var/log/caddy/arkan-monitoring.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

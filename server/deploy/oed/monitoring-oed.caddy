# Tested on a test machine on 8 Nov 2026 (tutorial 3, Appendix C); not yet run on hermes-vps.
# Changed on 10 Nov 2026 (v0.7.1, logins for this platform only, docs/LIVE.md "Logins"): not tested since; caddy validate first.
# Variant of server/deploy/monitoring.caddy for when Open Energy Dashboard (OED) is installed.
# It REPLACES /opt/edge/sites/monitoring.caddy on hermes-vps (native Caddy 2.6, imported by the main Caddyfile).
#   /                 -> OED (127.0.0.1:8810), behind the Arkan login
#   /live/ (and /live/<site>/register), /api/v1/*, /health -> our ingest service (127.0.0.1:8800), behind the Arkan login
#   logger endpoints  -> our ingest service, NO web login (the device token is checked by the service)
# OED uses only /api/<name> paths (users, meters, readings, csv, ...), never /api/v1, /live or /health
# (OED v1.0.0 src/server/app.js), so the two never collide.
# Logins: our service takes the Arkan logins (hub-users.caddy) and the logins for this platform only
# (monitoring-users.caddy, technicians, maybe limited to one site by USER_SITES: docs/LIVE.md "Logins").
# OED shows every site, so it takes the Arkan logins only. Both files must exist; the second holds at
# least a comment line (Caddy 2.6 refuses an empty imported file).
# After any change: caddy validate, then the owner approves the reload.

arkan-monitoring.duckdns.org {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Loggers: token checked by the service, body size capped here too (unchanged).
	@device {
		path /api/v1/ingest /api/v1/ota /api/v1/firmware/* /api/v1/config /api/v1/config/report /api/v1/registers
	}
	@livepost {
		method POST
		path /api/v1/live
	}
	handle @device {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8800
	}
	handle @livepost {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8800
	}

	# People, our ingest service: Arkan login or a login for this platform only.
	@ingest {
		path /live /live/* /api/v1/* /health
	}
	handle @ingest {
		basicauth {
			import /opt/edge/secrets/hub-users.caddy
			import /opt/edge/secrets/monitoring-users.caddy
		}
		reverse_proxy 127.0.0.1:8800 {
			header_up X-Auth-User {http.auth.user.id}
		}
	}

	# People, OED: Arkan login only (a login of monitoring-users.caddy gets the login box again).
	handle {
		basicauth {
			import /opt/edge/secrets/hub-users.caddy
		}

		# OED v1.0.0 does not check its own login on these write routes (new or changed units and
		# conversions, new meters, baselines, and the heavy rebuild of its unit table and views),
		# so through Caddy anyone with an Arkan login could change them (tested 8 Nov 2026).
		# Blocked from the internet; units, conversions and new meters are made with
		# oed-setup.py on the VPS loopback (tutorial 3, Part B). Editing a meter, groups,
		# users, maps and site settings still work in the browser (OED checks its admin login there).
		@oedunguarded {
			method POST PUT DELETE
			path /api/units/addUnit /api/units/edit /api/conversions/* /api/conversion-array/* /api/meters/addMeter /api/baselines/*
		}
		handle @oedunguarded {
			respond "Blocked by Caddy: use server/deploy/oed/oed-setup.py on the VPS (tutorial 3, Part B)" 403
		}

		# Optional, PLAN.md 5.4: hide OED's CSV upload API from the internet.
		# Uncomment only if nobody uses OED's CSV page in the browser: that page uses the same API.
		# The ingest service and curl on the VPS reach OED directly on 127.0.0.1:8810 anyway.
		# handle /api/csv/* {
		# 	respond 403
		# }

		# Everything else is OED. OED logs in with its own "token" header, so the Arkan
		# Authorization header is not needed there and is not passed on.
		handle {
			request_body {
				max_size 50MB
			}
			reverse_proxy 127.0.0.1:8810 {
				header_up -Authorization
			}
		}
	}

	log {
		output file /var/log/caddy/arkan-monitoring.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Token delete
			}
		}
	}
}

# Tested on a test machine on 8 Nov 2026 (tutorial 3, Appendix C); not yet run on hermes-vps.
# Secrets for Open Energy Dashboard. Copy to /srv/arkan-monitoring/oed/oed.env (outside the repository),
# chmod 600, and replace every <...> with a value from:  openssl rand -hex 24
# Keep a copy in the password manager.
# Never change OED_DB_PASSWORD after the first start: the database keeps the first one.

# PostgreSQL superuser "postgres" (database container only)
POSTGRES_PASSWORD=<postgres-superuser-password>

# Database user "oed", created by initdb/10-oed-user.sh, used by the OED web container
OED_DB_PASSWORD=<oed-database-password>

# Signs OED's login tokens (any long random value)
OED_TOKEN_SECRET=<oed-token-secret>
